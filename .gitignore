# Dependencias
node_modules/
.npm/

# Variables de entorno y secretos — NUNCA van al repo
.env
.env.local
.env.*.local
.env.production
.env.staging

# Respaldos previos a migraciones destructivas (update.js)
/backups/

# Estado del setup — es por instalación, no por repo
.setup-state.json

# Config local de test-eval (usar test-eval.config.example.json como base)
scripts/test-eval.config.json

# Logs
*.log
npm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Temporales
*.tmp
*.temp

# Supabase local (si usás el CLI)
.supabase/

# Output de tests
/test-results/
/coverage/
