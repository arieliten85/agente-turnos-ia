        "query": "SELECT b.handoff_phone,\n       b.name AS negocio,\n       cv.id  AS owner_conv_id\nFROM business b\nLEFT JOIN clients oc ON oc.phone = b.handoff_phone\nLEFT JOIN conversations cv ON cv.client_id = oc.id\nLIMIT 1;",
