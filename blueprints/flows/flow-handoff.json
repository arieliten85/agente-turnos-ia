      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, -120]
    },
    {
      "parameters": {
        "jsCode": "const t = $('Disparado por agente/webhook').item.json;\nconst duenio = $('Cargar dueño').item.json;\nconst cuerpo = [\n  '🔔 Handoff (' + (t.categoria || 'sin categoría') + ')',\n  'Clienta: ' + (t.waId || '—'),\n  'Motivo: ' + (t.razon || '—'),\n  'Último mensaje: ' + (t.lastClientMessage || '—'),\n  '',\n  'Respondé a este mensaje para contestarle a la clienta.'\n].join('\\n');\nconst waPayload = { messaging_product: 'whatsapp', to: duenio.handoff_phone, type: 'text', text: { body: cuerpo } };\nreturn [{ json: { waPayload } }];"
      },
      "id": "26e77c31-4d90-4a4f-8f0e-1d3a2b4c5d6e",
      "name": "Payload dueño (libre)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, -220]
    },
    {
      "parameters": {
        "jsCode": "const duenio = $('Cargar dueño').item.json;\nconst waPayload = {\n  messaging_product: 'whatsapp',\n  to: duenio.handoff_phone,\n  type: 'template',\n  template: {\n    name: '__WA_TEMPLATE_REENGAGEMENT__',\n    language: { code: '__WA_TEMPLATE_LANG__' }\n  }\n};\nreturn [{ json: { waPayload } }];"
      },
      "id": "3a7b1c2d-5e6f-4a8b-9c0d-2e3f4a5b6c7d",
      "name": "Payload dueño (plantilla)",
      "type": "n8n-nodes-base.code",
