        "jsCode": "const q = $input.first().json.query || {};\nif (q['hub.mode'] === 'subscribe' && q['hub.verify_token'] === '__WA_VERIFY_TOKEN__') {\n  return [{ json: { challenge: q['hub.challenge'] } }];\n}\nreturn [{ json: { challenge: 'invalid' } }];"
      },
