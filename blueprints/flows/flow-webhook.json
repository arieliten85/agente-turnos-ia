    {
      "parameters": {
        "jsCode": "const src = $('Extraer mensaje').item.json;\nlet buffer = [];\ntry { buffer = JSON.parse($json.bufferRaw || '[]'); } catch (e) { buffer = []; }\n\nconst nuevo = { wamid: src.wamid, text: src.text || '', type: src.type || 'text', ts: src.firstReceiptTs };\nif (!buffer.some(m => m.wamid === nuevo.wamid)) buffer.push(nuevo);\nbuffer = buffer.slice(-20);\n\nreturn [{ json: { waId: src.waId, buffer, bufferString: JSON.stringify(buffer), firstReceiptTs: buffer[0]?.ts || nuevo.ts } }];"
      },
