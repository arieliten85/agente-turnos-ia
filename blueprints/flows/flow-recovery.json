{
  "name": "turnos · flow-recovery",
  "meta": {
    "descripcion": "Cron cada 5 minutos. Busca en Redis las conversaciones con mensajes en buffer (__REDIS_PREFIX__:pending:*) cuya actividad supere __RECOVERY_STALE_SECONDS__ sin respuesta y sin lock tomado, y las procesa disparando flow-agent como si el Wait del webhook hubiera terminado. Cubre el reinicio de contenedor durante la espera.",
    "fragments": [],
    "placeholders": ["__CRED_REDIS__", "__REDIS_PREFIX__", "__RECOVERY_STALE_SECONDS__", "__FLOW_AGENT_ID__"],
    "notas": "El lock de conversación es lo que impide pisar un Wait vivo: flow-agent lo toma antes de leer el buffer, así que si acá el lock existe, se saltea. flow-agent borra la clave pending al responder."
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "tags": [],
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 2 }] }
      },
      "id": "2e3f4a5b-6c7d-4e8f-9a0b-1c2d3e4f5a6b",
      "name": "Cron 2 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "keys",
        "keyPattern": "=__REDIS_PREFIX__:pending:*",
        "options": {}
      },
      "id": "3f4a5b6c-7d8e-4f9a-0b1c-2d3e4f5a6b7c",
      "name": "Buscar pendientes",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [220, 0],
      "credentials": { "redis": { "id": "__CRED_REDIS__", "name": "__CRED_REDIS__" } }
    },
    {
      "parameters": {
        "fieldToSplitOut": "keys",
        "destinationFieldName": "pendingKey",
        "options": {}
      },
      "id": "4a5b6c7d-8e9f-4a0b-1c2d-3e4f5a6b7c8d",
      "name": "Separar claves",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "operation": "get",
        "propertyName": "pendingTs",
        "key": "={{ $json.pendingKey }}",
        "keyType": "string",
        "options": {}
      },
      "id": "5b6c7d8e-9f0a-4b1c-2d3e-4f5a6b7c8d9e",
      "name": "Leer ts de actividad",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [660, 0],
      "credentials": { "redis": { "id": "__CRED_REDIS__", "name": "__CRED_REDIS__" } }
    },
    {
      "parameters": {
        "operation": "get",
        "propertyName": "lockActual",
        "key": "=__REDIS_PREFIX__:lock:{{ $json.pendingKey.split(':').pop() }}",
        "keyType": "string",
        "options": {}
      },
      "id": "6c7d8e9f-0a1b-4c2d-3e4f-5a6b7c8d9e0f",
      "name": "Leer lock",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [880, 0],
      "credentials": { "redis": { "id": "__CRED_REDIS__", "name": "__CRED_REDIS__" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "id": "7d8e9f0a-1b2c-4d3e-4f5a-6b7c8d9e0f1a",
              "leftValue": "={{ $now.toMillis() - new Date($json.pendingTs).getTime() }}",
              "rightValue": "={{ Number('__RECOVERY_STALE_SECONDS__') * 1000 }}",
              "operator": { "type": "number", "operation": "gt" }
            },
            {
              "id": "8e9f0a1b-2c3d-4e4f-5a6b-7c8d9e0f1a2b",
              "leftValue": "={{ $json.lockActual }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notExists", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9f0a1b2c-3d4e-4f5a-6b7c-8d9e0f1a2b3c",
      "name": "¿Vencido y sin lock?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "workflowId": { "__rl": true, "value": "__FLOW_AGENT_ID__", "mode": "id" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "waId": "={{ $json.pendingKey.split(':').pop() }}",
            "via": "recovery"
          }
        },
        "options": { "waitForSubWorkflow": false }
      },
      "id": "0a1b2c3d-4e5f-4a6b-7c8d-9e0f1a2b3c4d",
      "name": "Disparar flow-agent",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [1320, -80]
    }
  ],
  "connections": {
    "Cron 2 min": { "main": [[{ "node": "Buscar pendientes", "type": "main", "index": 0 }]] },
    "Buscar pendientes": { "main": [[{ "node": "Separar claves", "type": "main", "index": 0 }]] },
    "Separar claves": { "main": [[{ "node": "Leer ts de actividad", "type": "main", "index": 0 }]] },
    "Leer ts de actividad": { "main": [[{ "node": "Leer lock", "type": "main", "index": 0 }]] },
    "Leer lock": { "main": [[{ "node": "¿Vencido y sin lock?", "type": "main", "index": 0 }]] },
    "¿Vencido y sin lock?": {
      "main": [
        [{ "node": "Disparar flow-agent", "type": "main", "index": 0 }],
        []
      ]
    }
  }
}
