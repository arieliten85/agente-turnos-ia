# ============================================================================
# .env — configuración de una instalación del agente de turnos
# ============================================================================
# Copiá este archivo a .env y completá lo que falte. NUNCA lo subas al repo.
# setup.js lee de acá para crear las credenciales de n8n y para reemplazar los
# marcadores de los flujos de blueprints/.
# Cada walkthrough de walkthroughs/ te dice de dónde sacar cada valor.
# ============================================================================

# ── Base de datos (Supabase) — walkthroughs/01-supabase.md ──────────────────
SUPABASE_PROJECT_REF=
SUPABASE_URL=
# USÁ EL POOLER (Supavisor), no la "Direct connection": el host directo
# db.<ref>.supabase.co es IPv6-only y la red de Docker no lo alcanza
# (n8n falla con ENETUNREACH en los nodos Postgres). Formato Session mode:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# La usan test-eval.js (para aislar corridas) y update.js.

# ── Redis — local, lo levanta docker-compose ───────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PREFIX=turnos

# ── Modelo de IA — walkthroughs/05-modelo-api-key.md ───────────────────────
# provider: gemini (desarrollo/demo, free tier) | claude (producción)
MODEL_PROVIDER=gemini
# flash-lite responde rápido y aguanta el payload con las 9 tools. El alias
# -latest evita que se pinche por deprecación (gemini-2.0-flash ya devuelve 404).
MODEL_NAME=gemini-flash-lite-latest
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── WhatsApp Cloud API (Meta) — walkthroughs/02-meta-app-y-numero.md ───────
# En dev apuntá WA_API_BASE al capture server de simulator.js
# (ej http://host.docker.internal:3999). En prod dejalo en la Graph API.
WA_API_BASE=https://graph.facebook.com
WA_GRAPH_VERSION=v21.0
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
# Token permanente de un System User con permiso whatsapp_business_messaging.
WA_TOKEN=
# Inventá una cadena larga y aleatoria; la misma va en el webhook de Meta.
WA_VERIFY_TOKEN=
WA_TEMPLATE_LANG=es_AR
# Nombres EXACTOS de las 4 plantillas aprobadas — walkthroughs/03-plantillas-whatsapp.md
WA_TEMPLATE_REMINDER=turno_recordatorio
WA_TEMPLATE_CANCELLATION=turno_cancelado_hueco
WA_TEMPLATE_WAITLIST=turno_lista_espera
WA_TEMPLATE_REENGAGEMENT=handoff_reengagement
# WhatsApp del dueño para los handoffs, en E.164 SIN el "+" (ej 5491122334455).
HANDOFF_PHONE_DIGITS=

# ── n8n ───────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# URL pública del túnel (sin barra final), ej https://turnos.tudominio.com
WEBHOOK_URL=
# Path del webhook de Meta dentro de n8n (aleatorio por instalación).
WEBHOOK_PATH=wa-turnos
# 32+ caracteres aleatorios. Si lo cambiás después, n8n no puede leer las credenciales viejas.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires
# Para el fallback por REST cuando no está el MCP de n8n (Settings → n8n API).
N8N_API_KEY=

# ── Cloudflare Tunnel — walkthroughs/04-cloudflare-tunnel.md ───────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Runtime de los flujos (defaults del brief; tocá solo si hace falta) ────
BUFFER_SECONDS=2.5
BUFFER_TTL_SECONDS=60
RECOVERY_STALE_SECONDS=30
REMINDER_TYPE=24h
# Rotación de tablas de observabilidad (flow-cleanup, cron diario).
PROCESSED_RETENTION_DAYS=7
RUNS_RETENTION_DAYS=90

# ── Simulador y tests (solo desarrollo) ───────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/wa-turnos
SIMULATOR_CAPTURE_PORT=3999
